# Copy this file to config.env and fill in the values Jing Yuan sends you.
# "test" for FoundIt-Test, "live" for the deployed database
DB_TARGET=test
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
JWT_SECRET=
CRON_SECRET=
# Email alerts (Member 6). Leave empty to send no emails.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# The branded template for the email-verification code (server/email-templates/verify-email.html)
EMAILJS_VERIFY_TEMPLATE_ID=
# Photo tag suggestions on the report form (Member 2). Leave empty to switch them off.
GOOGLE_VISION_API_KEY=
# Semantic matching (Member 3): Google Gemini embeddings, free tier. Leave empty to match
# descriptions on shared words only. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Our Cloudinary account (the same as the client's VITE_CLOUDINARY_CLOUD_NAME), so only
# photos uploaded through the report form get tag suggestions. Empty accepts any Cloudinary photo.
CLOUDINARY_CLOUD_NAME=
# Address used in links inside emails
APP_URL=https://foundit-chi-amber.vercel.app
