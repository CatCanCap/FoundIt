# Copy to .env.local (never committed). Only public values go here: the
# browser can read everything in this file.
# Supabase Realtime, used only for "new chat message" pings. Ask Jing Yuan for
# the project URL and the PUBLISHABLE key (never the secret key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_MAPBOX_TOKEN=
# Photo upload on the report form (WS2, services/cloudinary.js). The account's
# cloud name and an UNSIGNED upload preset; never the Cloudinary API secret.
# Leave empty to hide the photo field.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
# Optional: the API's address. Leave empty to use http://localhost:8000/api in
# development and /api when deployed.
VITE_API_URL=
